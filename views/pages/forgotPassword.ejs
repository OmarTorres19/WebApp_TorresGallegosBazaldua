<%- include('../partials/header', { title: 'Account Recovery' }) %>

  <main class="form-container">
    <div class="form-bat-logo" aria-hidden="true">
        <svg viewBox="0 0 100 45" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
            <path d="M50,8 C45,8 40,14 36,20 C28,20 16,14 0,22 C12,28 20,38 30,36 C36,34 40,28 44,25 C46,24 48,23 50,23 C52,23 54,24 56,25 C60,28 64,34 70,36 C80,38 88,28 100,22 C84,14 72,20 64,20 C60,14 55,8 50,8 Z"/>
        </svg>
    </div>
    <h2>Account <strong>Recovery</strong></h2>
    <form id="recoveryForm" novalidate>
      <div id="recovery-step-1">
        <label for="email">Enter your Email:</label>
        <input type="email" id="email" name="email" required placeholder="bruce@wayne.com">
        <div class="btnContainer">
          <button class="submit" type="button" id="btnLoadQuestion">Find Identity</button>
        </div>
      </div>

      <div id="recovery-step-2" class="hidden">
        <p class="hint">Security Challenge: <strong id="display-question"></strong></p>

        <label for="passphrase">Your Secret Answer:</label>
        <div class="input-wrapper">
            <input type="password" id="passphrase" name="passphrase" required>
            <button type="button" class="toggle-password" onclick="togglePwd('passphrase')" aria-label="Toggle answer visibility">👁</button>
        </div>

        <label for="newPassword">New Secure Password:</label>
        <div class="input-wrapper">
            <input type="password" id="newPassword" name="newPassword" required minlength="8">
            <button type="button" class="toggle-password" onclick="togglePwd('newPassword')" aria-label="Toggle new password visibility">👁</button>
        </div>

        <div class="btnContainer">
          <button class="submit" type="submit">Update Protocols</button>
        </div>
      </div>
    </form>
    <div class="helper">
      <a href="/login">Back to Login</a>
    </div>
  </main>
  <script src="/js/toast.js"></script>
  <script src="/js/forgot.js"></script>

<%- include('../partials/footer', { scripts: ['/js/forgot.js'] }) %>