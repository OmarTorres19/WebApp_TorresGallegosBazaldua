<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ID Verified</title>

    <link rel="stylesheet" href="../css/formStyle.css" type="text/css" />
</head>

<body>
    <main class="form-container">
        <div class="form-bat-logo" aria-hidden="true">
            <svg viewBox="0 0 100 45" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
                <path d="M50,8 C45,8 40,14 36,20 C28,20 16,14 0,22 C12,28 20,38 30,36 C36,34 40,28 44,25 C46,24 48,23 50,23 C52,23 54,24 56,25 C60,28 64,34 70,36 C80,38 88,28 100,22 C84,14 72,20 64,20 C60,14 55,8 50,8 Z"/>
            </svg>
        </div>
        <h2>Access <strong>BatFiles</strong></h2>
        <form id="loginForm" method="POST" novalidate>
            <label for="email">Email Address:</label>
            <input type="email" id="email" name="email" required>

            <label for="password">Password:</label>
            <div class="input-wrapper">
                <input type="password" id="password" name="password" required>
                <button type="button" class="toggle-password" onclick="togglePwd('password')" aria-label="Toggle password visibility">👁</button>
            </div>

            <div class="btnContainer">
                <button class="submit" type="submit">Unlock</button>
            </div>

            

            <div class="footer-links">
                <p><a href="/forgotPassword" class="bat-link">Forgot password?</a></p>

                <p><a href="/register" class="bat-link">Create new account</a></p>
            </div>

        </form>

    </main>

    <script src="/js/toast.js"></script>
    <script src="/js/login.js"></script>

</body>

</html>